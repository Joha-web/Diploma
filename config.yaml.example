# ReconX configuration template.
# Copy to config.yaml for local use. Do not commit real secrets.

api_keys:
  shodan: ""
  virustotal: ""
  wpscan: ""       # or env WPSCAN_API_TOKEN
  censys_api_id: ""            # optional; only needed for Legacy Search API
  censys_api_secret: ""        # env CENSYS_API_SECRET/CENSYS_PAT; Platform PAT, or Legacy secret when censys_api_id is set
  securitytrails: ""
  binaryedge: ""
  github: ""
  pdcp: ""

preset: ""  # safe | bug_bounty | deep | intrusive

auth_profiles:
  anonymous: {}
  user_a:
    token: ""
    token_type: "Bearer"
    headers: {}
    cookies: {}
  user_b:
    token: ""
    token_type: "Bearer"
    headers: {}
    cookies: {}
  admin:
    token: ""
    token_type: "Bearer"
    headers: {}
    cookies: {}

telegram:
  enabled: true
  bot_token: ""     # or env TELEGRAM_BOT_TOKEN
  chat_id: ""       # or env TELEGRAM_CHAT_ID
  notify_on:
    - start
    - module_complete
    - critical_finding
    - complete

ai:
  enabled: true
  provider: "ollama"               # ollama | openai | anthropic
  model: "deepseek-r1:7b"
  ollama_url: "http://localhost:11434"
  openai_api_key: ""
  openai_base_url: "https://api.openai.com/v1"
  anthropic_api_key: ""            # or set ANTHROPIC_API_KEY in env
  anthropic_model: "claude-sonnet-4-6"
  anthropic_base_url: "https://api.anthropic.com"
  temperature: 0.3
  max_tokens: 4096
  language: "en"
  realtime_advice: false
  advise_on: [recon, portscan, techstack, fuzzer, vulnscan, cve_check]

scan:
  threads: 50
  timeout: 30
  rate_limit: 50
  global_rate_limit: 50
  allow_write: false

  # AI false-positive triage (runs after the correlator). use_ai sends
  # findings to the configured LLM (billed); false = free heuristic only.
  fp_triage:
    enabled: true
    use_ai: true
    max_findings: 80
    fp_confidence_threshold: 0.6

  subdomains:
    use_subfinder: true
    use_amass: true
    use_assetfinder: true
    use_crtsh: true
    use_hackertarget: true
    use_alienvault: true
    use_rapiddns: true
    use_wayback_cdx: true
    use_threatminer: true
    use_shodan: true
    use_censys: true
    use_github: true
    use_securitytrails: false
    use_binaryedge: false
    api_retries: 1
    api_retry_delay: 1.0
    api_retry_backoff: 2.0
    api_retry_max_delay: 10.0
    wayback_timeout: 15
    wayback_limit: 1000
    github_per_page: 30
    amass_timeout: 180
    enable_active_enum: false
    use_active_bruteforce: false
    active_wordlist: "subdomains-top1million-5000.txt"
    active_threads: 100
    active_timeout: 900
    use_asn_lookup: false
    max_asn_lookups: 40
    asn_lookup_delay: 1.0
    exclude_cdn_ips: true
    # altdns-style permutation brute-force (requires dnsx; gotator optional)
    use_permutations: false
    permutation_extra_words: []
    permutation_max: 5000
    permutation_threads: 100
    permutation_timeout: 600
    # origin-IP discovery for hosts that sit behind a CDN/WAF
    use_origin_discovery: false
    origin_max_lookups: 50
    # extended URL harvesting per live host
    use_katana: false
    katana_depth: 2
    katana_timeout: 300
    use_well_known: true
    well_known_max_hosts: 50
    well_known_timeout: 10
    # reverse-WHOIS / org-pivoting via crt.sh ?O= search
    use_reverse_whois: false
    reverse_whois_max_domains: 100
    # active S3/GCS/Azure bucket guessing
    use_cloud_buckets: false
    cloud_bucket_extra_words: []
    cloud_bucket_max: 2000
    cloud_bucket_threads: 20
    cloud_bucket_timeout: 5
    # pull SANs from each live host's TLS cert and merge same-domain SANs back
    use_cert_san_graph: false
    cert_san_max_hosts: 80
    cert_san_timeout: 5
    # synthesis step: tie sub ↔ IP ↔ ASN ↔ cert ↔ tech ↔ endpoints
    build_asset_graph: true

  secret_scanner:
    enabled: true
    max_repos: 20
    github_per_page: 20
    github_timeout: 15
    clone_timeout: 120
    scan_timeout: 120

  ports:
    mode: "top-1000"
    scanner: "nmap"
    masscan_rate: 3000

  http:
    follow_redirects: true
    tech_detect: true
    screenshots: false        # requires gowitness; output under recon/screenshots/
    screenshot_threads: 5
    screenshot_timeout: 600

  fuzzing:
    depth: 3
    rate: 100
    graphql_probe: true
    graphql_introspection: true
    robots_sitemap: true
    cloud_assets: true
    cloud_listing_threads: 10
    reuse_host_outputs: true
    extensions: [".php", ".asp", ".aspx", ".jsp", ".html", ".js", ".json"]
    # Liveness filter for the "Discovered Endpoints" categories (api, auth,
    # admin_panels, interesting_directories, interesting_endpoints, with_params):
    # probe each and drop the ones returning 404 / 400 / 429 / 403.
    verify_endpoints: true
    verify_threads: 10
    verify_timeout: 8
    verify_max_per_category: 500

  # Endpoint harvesting — wraps cariddi, LinkFinder, xnLinkFinder and kiterunner.
  # gau / waybackurls run in the recon module, so passive harvesting is not
  # duplicated here. Each tool is optional; a missing binary is skipped.
  endpoint_harvester:
    enabled: true
    max_seeds: 200              # cap seed URLs fed to the crawlers
    timeout: 300
    reuse_outputs: true
    # cariddi (crawl + secrets + params + juicy info)
    cariddi: true
    cariddi_intensive: false    # deeper same-domain crawl (bug_bounty+ presets)
    cariddi_concurrency: 20
    cariddi_collect_secrets: true
    # LinkFinder (endpoints from JS bundles)
    linkfinder: true
    linkfinder_path: ""         # override path to linkfinder.py if not on PATH
    max_js: 100                 # cap JS bundles scanned
    # xnLinkFinder (endpoints + params from the seed list)
    xnlinkfinder: true
    xnlinkfinder_path: ""       # override path to xnLinkFinder.py if not on PATH
    # kiterunner (aggressive API route brute-force) — off by default,
    # enabled by the deep / intrusive presets.
    kiterunner: false
    kiterunner_intensive: false # use the larger apiroutes-large wordlist
    kiterunner_concurrency: 10
    kiterunner_wordlist: ""     # path to a .txt/.kite wordlist; empty → -A alias
    kiterunner_max_routes: 0    # 0 = tool default

  cors_checker:
    enabled: true
    max_urls: 200

  auth_probe:
    enabled: true
    max_urls: 150

  sourcemap_analyzer:
    enabled: true
    max_js: 150

  vhost_enum:
    enabled: true
    max_ips: 40
    rate: 50
    timeout: 600
    wordlist: "subdomains-top1million-5000.txt"

  openapi_parser:
    enabled: true
    max_hosts: 100

  parameter_discovery:
    enabled: true
    max_targets: 150
    threads: 10
    delay: 2
    timeout: 1200

  injection_probe:
    enabled: true
    max_targets: 50
    max_ssti_requests: 250
    max_ssrf_requests: 150
    timeout: 15
    ssrf_wait: 5
    ssti: true
    ssrf: true
    inband_ssrf: false

  sql_injection:
    enabled: true
    max_targets: 10
    timeout: 900
    level: 1
    risk: 1
    threads: 1
    request_timeout: 10
    retries: 1
    smart: true
    random_agent: true
    forms: false
    crawl: 0
    tamper: ""
    extra_args: []

  xss:
    enabled: true
    max_targets: 25
    timeout: 600
    use_dalfox: true
    fallback_reflection: true
    max_requests: 150
    max_payloads: 2
    request_timeout: 10
    workers: 1
    dalfox_timeout: 600
    dalfox_extra_args: []
    # Heavier external scanners — run when their binary is present, skipped
    # gracefully otherwise. Capped by max_tool_targets (they crawl per target).
    max_tool_targets: 20
    use_xsstrike: true
    xsstrike_path: ""          # override path to xsstrike.py if not on PATH
    xsstrike_timeout: 600
    xsstrike_extra_args: []
    use_xsser: true
    xsser_threads: 3
    xsser_timeout: 600
    xsser_extra_args: []

  http_smuggling:
    enabled: true
    max_urls: 40
    timing_threshold: 4.5
    connect_timeout: 8
    read_timeout: 6

  oauth_probe:
    enabled: true
    max_hosts: 40
    timeout: 8

  host_header_injection:
    enabled: true
    max_urls: 80
    timeout: 10

  prototype_pollution:
    enabled: true
    max_targets: 80
    timeout: 10
    body_probes: false

  xxe_probe:
    enabled: true
    max_targets: 40
    timeout: 10
    oob_wait: 5

  deserialization_probe:
    enabled: true
    max_urls: 100
    timeout: 10

  race_condition:
    enabled: true
    max_targets: 80
    active_probe: false
    max_active_targets: 5
    parallel_requests: 2
    timeout: 8

  open_redirect_probe:
    enabled: true
    max_targets: 120
    timeout: 8

  api_key_validator:
    enabled: true
    max_candidates: 100
    live_validation: false
    timeout: 10

  idor_probe:
    enabled: true
    max_candidates: 200
    compare_profiles: false
    check_anonymous: false
    max_compare_requests: 40
    max_anonymous_requests: 20
    similarity_threshold: 0.92
    timeout: 10

  jwt_audit:
    enabled: true
    max_tokens: 100
    collect_from_responses: false
    max_response_urls: 50
    max_token_ttl_seconds: 604800
    max_secret_guesses: 50
    weak_secrets: []
    trusted_key_hosts: []
    timeout: 10

  websocket_probe:
    enabled: true
    max_hosts: 30
    max_endpoints: 50
    discover_common_paths: true
    active_handshake: true
    check_origin: true
    attacker_origin: "https://attacker.reconx.invalid"
    message_probe: false
    timeout: 8

  api_schema_audit:
    enabled: true
    max_endpoints: 500

  js_security_audit:
    enabled: true
    max_js: 150
    max_html_hosts: 40
    max_findings_per_js: 20
    timeout: 10

  takeover_checker:
    enabled: true
    max_hosts: 500

  nuclei:
    enabled: true
    severity: [critical, high, medium]
    templates: [cves, exposures, misconfiguration, takeovers]
    enable_risky: false
    exclude_tags: [dos, intrusive, bruteforce, destructive]
    rate_limit: 150
    waf_rate_limit: 30
    waf_scan_strategy: host-spray
    waf_exclude_tags: [fuzz, fuzzing, bruteforce, headless]
    nuclei_timeout: 3600
    dashboard_upload: false
    oob:
      enabled: true
      auto_client: true
      interactsh_server: ""
      interactsh_token: ""
      registration_timeout: 10
      cooldown_period: 5

  correlator:
    enabled: true

  cms:
    wpscan_api_token: ""  # optional override; falls back to api_keys.wpscan / WPSCAN_API_TOKEN
    enumerate: "vp,vt,u,tt"

  cve_check:
    enabled: true
    searchsploit: true
    max_queries: 40
    attack_simulation: dry_run

wordlists:
  search_paths:
    - /opt/SecLists
    - /usr/share/seclists
    - /usr/share/wordlists
    - /usr/share/dirb/wordlists
  dirs: "directory-list-2.3-medium.txt"
  files: "raft-medium-files.txt"
  params: "burp-parameter-names.txt"

reporting:
  formats: [html, md, json]
  language: "en"

scope:
  enforce: true
  allowed_domains: []
  allowed_ips: []
  excluded: []

legal:
  require_acknowledgment: false

config_presets: {}
