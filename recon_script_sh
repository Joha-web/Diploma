#!/usr/bin/env bash

# =============================================================================
# recon.sh — passive + light active reconnaissance
# usage: bash recon.sh <domain|ip> [output_dir]
# =============================================================================

set -uo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

info(){ echo -e "${CYAN}[*]${NC} $*"; }
success(){ echo -e "${GREEN}[+]${NC} $*"; }
warn(){ echo -e "${YELLOW}[!]${NC} $*"; }

banner(){
echo -e "\n${BOLD}${MAGENTA}════════ $* ════════${NC}\n"
}

TARGET_RAW="${1:-}"

if [[ -z "$TARGET_RAW" ]]; then
    echo "Usage: bash recon.sh <domain|ip>"
    exit 1
fi

TARGET=$(echo "$TARGET_RAW" | sed -E 's#https?://##; s#/$##; s#^\*\.##')
DOMAIN="$TARGET"

SAFE=$(echo "$DOMAIN" | sed 's/[^a-zA-Z0-9._-]/_/g')
OUTPUT_DIR="${2:-./recon_${SAFE}_$(date +%Y%m%d_%H%M%S)}"

mkdir -p "$OUTPUT_DIR"/{subdomains,dns,urls,passive}

MASTER="$OUTPUT_DIR/subdomains/all_subdomains.txt"
touch "$MASTER"

has(){ command -v "$1" &>/dev/null; }
lc(){ [[ -f "$1" ]] && wc -l < "$1" || echo 0; }

escape_domain(){
printf "%s\n" "$DOMAIN" | sed 's/\./\\./g'
}

DOMAIN_ESC=$(escape_domain)

is_valid(){
grep -iE "^([a-z0-9_-]+\.)*${DOMAIN_ESC}$"
}

merge(){
local src="$1"

if [[ -f "$src" ]]; then
cat "$src"  | tr '[:upper:]' '[:lower:]'  | sed 's/^\*\.//'  | is_valid  >> "$MASTER"

sort -u "$MASTER" -o "$MASTER"
fi
}

banner "checking tools"

for t in subfinder amass assetfinder dnsx httpx curl jq dig waybackurls gau; do
if has "$t"; then
success "$t"
else
warn "$t not installed"
fi
done

banner "passive enumeration"

if has subfinder; then
info "subfinder"
subfinder -silent -d "$DOMAIN" > "$OUTPUT_DIR/subdomains/subfinder.txt" || true
merge "$OUTPUT_DIR/subdomains/subfinder.txt"
fi

if has assetfinder; then
info "assetfinder"
assetfinder --subs-only "$DOMAIN" > "$OUTPUT_DIR/subdomains/assetfinder.txt" || true
merge "$OUTPUT_DIR/subdomains/assetfinder.txt"
fi

if has amass; then
info "amass"
amass enum -passive -d "$DOMAIN" > "$OUTPUT_DIR/subdomains/amass.txt" || true
merge "$OUTPUT_DIR/subdomains/amass.txt"
fi

banner "crt.sh"

curl -s "https://crt.sh/?q=%25.${DOMAIN}&output=json"  | jq -r '.[].name_value'  | tr ',' '\n'  | sed 's/\*\.//'  > "$OUTPUT_DIR/subdomains/crtsh.txt" || true

merge "$OUTPUT_DIR/subdomains/crtsh.txt"

banner "wayback"

if has waybackurls; then
waybackurls "$DOMAIN"  | sed 's#https\?://##'  | cut -d/ -f1  > "$OUTPUT_DIR/urls/wayback_hosts.txt"

merge "$OUTPUT_DIR/urls/wayback_hosts.txt"
fi

banner "wildcard test"

RANDOM_SUB="wildcard-test-$(openssl rand -hex 4).$DOMAIN"

if dig +short "$RANDOM_SUB" | grep -q .; then
warn "domain has wildcard DNS (may produce false positives)"
else
success "no wildcard detected"
fi

banner "dns resolution"

if has dnsx; then

dnsx -silent -l "$MASTER" -a -resp -o "$OUTPUT_DIR/dns/resolved.txt" || true

cut -d' ' -f1 "$OUTPUT_DIR/dns/resolved.txt"  > "$OUTPUT_DIR/subdomains/live_subdomains.txt"

success "live hosts: $(lc "$OUTPUT_DIR/subdomains/live_subdomains.txt")"

else

warn "dnsx missing — using dig (slow)"

while read -r sub; do
ip=$(dig +short "$sub" | head -n1)
if [[ -n "$ip" ]]; then
echo "$sub [$ip]" >> "$OUTPUT_DIR/dns/resolved.txt"
echo "$sub" >> "$OUTPUT_DIR/subdomains/live_subdomains.txt"
fi
done < "$MASTER"

fi

banner "http probing"

if has httpx; then

httpx -silent  -l "$OUTPUT_DIR/subdomains/live_subdomains.txt"  -title -status-code  -follow-redirects  -threads 100  > "$OUTPUT_DIR/subdomains/httpx.txt"

success "http services: $(lc "$OUTPUT_DIR/subdomains/httpx.txt")"

else

warn "httpx missing"

fi

banner "summary"

echo "domain: $DOMAIN"
echo "all subdomains: $(lc "$MASTER")"
echo "resolved: $(lc "$OUTPUT_DIR/subdomains/live_subdomains.txt")"
echo "http services: $(lc "$OUTPUT_DIR/subdomains/httpx.txt")"

echo ""
success "results stored in:"
echo "$OUTPUT_DIR"
