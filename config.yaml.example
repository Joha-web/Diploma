# ReconX configuration template.
# Copy to config.yaml for local use. Do not commit real secrets.

api_keys:
  shodan: ""
  virustotal: ""
  wpscan: ""       # or env WPSCAN_API_TOKEN
  censys_api_id: ""            # optional; only needed for Legacy Search API
  censys_api_secret: ""        # Platform PAT, or Legacy secret when censys_api_id is set
  securitytrails: ""
  binaryedge: ""
  github: ""
  pdcp: ""

telegram:
  enabled: true
  bot_token: ""     # or env TELEGRAM_BOT_TOKEN
  chat_id: ""       # or env TELEGRAM_CHAT_ID
  notify_on:
    - start
    - module_complete
    - critical_finding
    - complete

ai:
  enabled: true
  provider: "ollama"
  model: "deepseek-r1:7b"
  ollama_url: "http://localhost:11434"
  openai_api_key: ""
  openai_base_url: "https://api.openai.com/v1"
  temperature: 0.3
  max_tokens: 4096
  language: "en"
  realtime_advice: false
  advise_on: [recon, portscan, techstack, fuzzer, vulnscan, cve_check]

scan:
  threads: 50
  timeout: 30
  rate_limit: 50
  global_rate_limit: 50
  allow_write: false

  subdomains:
    use_subfinder: true
    use_amass: true
    use_assetfinder: true
    use_crtsh: true
    use_hackertarget: true
    use_alienvault: true
    use_rapiddns: true
    use_wayback_cdx: true
    use_threatminer: true
    use_shodan: true
    use_censys: true
    use_github: true
    use_securitytrails: false
    use_binaryedge: false
    wayback_timeout: 15
    wayback_limit: 1000
    github_per_page: 30
    amass_timeout: 180
    enable_active_enum: false
    use_active_bruteforce: false
    active_wordlist: "subdomains-top1million-5000.txt"
    active_threads: 100
    active_timeout: 900
    use_asn_lookup: false
    max_asn_lookups: 40
    asn_lookup_delay: 1.0
    exclude_cdn_ips: true

  ports:
    mode: "top-1000"
    scanner: "nmap"
    masscan_rate: 3000

  http:
    follow_redirects: true
    tech_detect: true
    screenshots: false

  fuzzing:
    depth: 3
    rate: 100
    graphql_probe: true
    graphql_introspection: true
    robots_sitemap: true
    cloud_assets: true
    cloud_listing_threads: 10
    reuse_host_outputs: true
    extensions: [".php", ".asp", ".aspx", ".jsp", ".html", ".js", ".json"]

  cors_checker:
    enabled: true
    max_urls: 200

  auth_probe:
    enabled: true
    max_urls: 150

  sourcemap_analyzer:
    enabled: true
    max_js: 150

  vhost_enum:
    enabled: true
    max_ips: 40
    rate: 50
    timeout: 600
    wordlist: "subdomains-top1million-5000.txt"

  openapi_parser:
    enabled: true
    max_hosts: 100

  parameter_discovery:
    enabled: true
    max_targets: 150
    threads: 10
    delay: 2
    timeout: 1200

  takeover_checker:
    enabled: true
    max_hosts: 500

  nuclei:
    enabled: true
    severity: [critical, high, medium]
    templates: [cves, exposures, misconfiguration, takeovers]
    enable_risky: false
    exclude_tags: [dos, intrusive, bruteforce, destructive]
    rate_limit: 150
    waf_rate_limit: 30
    waf_scan_strategy: host-spray
    waf_exclude_tags: [fuzz, fuzzing, bruteforce, headless]
    nuclei_timeout: 3600
    dashboard_upload: false
    oob:
      enabled: true
      auto_client: true
      interactsh_server: ""
      interactsh_token: ""
      registration_timeout: 10
      cooldown_period: 5

  correlator:
    enabled: true

  cms:
    wpscan_api_token: ""  # optional override; falls back to api_keys.wpscan / WPSCAN_API_TOKEN
    enumerate: "vp,vt,u,tt"

  cve_check:
    enabled: true
    searchsploit: true
    max_queries: 40
    attack_simulation: dry_run

wordlists:
  search_paths:
    - /opt/SecLists
    - /usr/share/seclists
    - /usr/share/wordlists
    - /usr/share/dirb/wordlists
  dirs: "directory-list-2.3-medium.txt"
  files: "raft-medium-files.txt"
  params: "burp-parameter-names.txt"

reporting:
  formats: [html, md, json]
  language: "en"

scope:
  enforce: true
  allowed_domains: []
  allowed_ips: []
  excluded: []

legal:
  require_acknowledgment: false
